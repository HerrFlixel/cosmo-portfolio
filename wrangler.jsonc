{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmo-web",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cosmo-db",
      "database_id": "bcb41797-0811-40f3-9220-1fb9d8c857db",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cosmo-media"
    }
  ],
  "env": {
    "preview": {
      "name": "cosmo-web-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cosmo-db-preview",
          "database_id": "f22ff711-5cba-4923-bc84-89c43415ff9a",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cosmo-media-preview"
        }
      ]
    }
  }
}
