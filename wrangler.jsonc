{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmo-web",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cosmo-db",
      "database_id": "bcb41797-0811-40f3-9220-1fb9d8c857db",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cosmo-media"
    },
    // Privat: Galerie-Dateien nur über den Worker mit Galerie-Cookie – nie eine Custom Domain daran hängen.
    {
      "binding": "GALLERIES",
      "bucket_name": "cosmo-galleries"
    }
  ],
  "vars": { "ADMIN_USERNAME": "felix" },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GALLERY_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    "preview": {
      "name": "cosmo-web-preview",
      "vars": { "ADMIN_USERNAME": "felix" },
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
        { "name": "GALLERY_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cosmo-db-preview",
          "database_id": "f22ff711-5cba-4923-bc84-89c43415ff9a",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cosmo-media-preview"
        },
        {
          "binding": "GALLERIES",
          "bucket_name": "cosmo-galleries-preview"
        }
      ]
    }
  }
}
